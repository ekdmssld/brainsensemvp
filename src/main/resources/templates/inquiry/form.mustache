{{>layouts/shop-header}}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- 메시지 표시 -->
            {{#message}}
                <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
                    {{message}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {{/message}}

            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i>
                        {{#isEdit}}문의 수정{{/isEdit}}
                        {{^isEdit}}문의 작성{{/isEdit}}
                    </h4>
                </div>
                <div class="card-body">
                    <form action="{{#isEdit}}/inquiry/{{inquiry.id}}{{/isEdit}}{{^isEdit}}/inquiry{{/isEdit}}"
                          method="post">

                        <!-- 문의 유형 -->
                        <div class="mb-3">
                            <label class="form-label">문의 유형 *</label>
                            <select class="form-select" name="type" required>
                                <option value="">유형을 선택하세요</option>
                                {{#types}}
                                    <option value="{{name}}" {{#selected}}selected{{/selected}}>
                                        {{description}}
                                    </option>
                                {{/types}}
                            </select>
                        </div>

                        <!-- 제목 -->
                        <div class="mb-3">
                            <label class="form-label">제목 *</label>
                            <input type="text" class="form-control" name="title"
                                   value="{{inquiry.title}}"
                                   placeholder="제목을 입력하세요"
                                   required maxlength="200">
                        </div>

                        <!-- 내용 -->
                        <div class="mb-3">
                            <label class="form-label">문의 내용 *</label>
                            <textarea class="form-control" name="content" rows="10"
                                      placeholder="문의 내용을 상세히 입력해주세요"
                                      required>{{inquiry.content}}</textarea>
                            <small class="text-muted">
                                상품명, 주문번호 등 상세 정보를 함께 적어주시면 더 빠른 답변이 가능합니다.
                            </small>
                        </div>

                        <!-- 안내 메시지 -->
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>안내사항</strong>
                            <ul class="mb-0 mt-2">
                                <li>문의 내용은 본인만 조회 가능합니다.</li>
                                <li>답변은 영업일 기준 1-2일 이내에 등록됩니다.</li>
                                <li>답변이 등록되면 알림을 통해 확인하실 수 있습니다.</li>
                            </ul>
                        </div>

                        <!-- 버튼 -->
                        <div class="d-flex justify-content-between">
                            <a href="/inquiry" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> 취소
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i>
                                {{#isEdit}}수정 완료{{/isEdit}}
                                {{^isEdit}}문의 등록{{/isEdit}}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}