{{>layouts/shop-header}}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-9 mx-auto">
            <!-- 메시지 표시 -->
            {{#message}}
                <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
                    {{message}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {{/message}}

            <!-- 뒤로가기 버튼 -->
            <div class="mb-3">
                <a href="/inquiry" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> 목록으로
                </a>
            </div>

            <!-- 문의 상세 카드 -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-2">{{inquiry.title}}</h5>
                            <div>
                                <span class="badge bg-info me-2">{{inquiry.typeDescription}}</span>
                                <span class="badge bg-{{inquiry.statusBadgeClass}}">
                                    <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> {{inquiry.statusDescription}}
                                </span>
                            </div>
                        </div>
                        <div>
                            {{#isPending}}
                                <a href="/inquiry/{{inquiry.id}}/edit" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i> 수정
                                </a>
                            {{/isPending}}
                            <form action="/inquiry/{{inquiry.id}}/delete" method="post" class="d-inline"
                                  onsubmit="return confirm('문의를 삭제하시겠습니까?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> 삭제
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted">
                            <i class="bi bi-person-circle"></i> {{inquiry.username}} |
                            <i class="bi bi-calendar3"></i> {{inquiry.formattedCreatedAt}}
                        </small>
                    </div>
                    <hr>
                    <div class="inquiry-content py-3" style="white-space: pre-wrap; line-height: 1.8;">{{inquiry.content}}</div>
                </div>
            </div>

            <!-- 답변 섹션 -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-left-text"></i> 답변
                        <span class="badge bg-secondary">{{comments.size}}</span>
                    </h5>
                </div>
                <div class="card-body">
                    {{#comments}}
                        <div class="mb-4 {{#isAdmin}}border-start border-danger border-4 ps-3{{/isAdmin}}">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center">
                                    {{#isAdmin}}
                                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                             style="width: 36px; height: 36px;">
                                            <i class="bi bi-shield-fill-check"></i>
                                        </div>
                                    {{/isAdmin}}
                                    {{^isAdmin}}
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                             style="width: 36px; height: 36px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                    {{/isAdmin}}
                                    <div>
                                        <strong class="d-block">{{username}}</strong>
                                        {{#isAdmin}}<span class="badge bg-danger" style="font-size: 0.7rem;">관리자</span>{{/isAdmin}}
                                        <small class="text-muted d-block">{{formattedCreatedAt}}</small>
                                    </div>
                                </div>
                                {{#deletable}}
                                    <form action="/inquiry/comment/{{id}}/delete" method="post" class="d-inline"
                                          onsubmit="return confirm('댓글을 삭제하시겠습니까?');">
                                        <input type="hidden" name="inquiryId" value="{{inquiryId}}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                {{/deletable}}
                            </div>
                            <div class="ms-5 ps-1" style="white-space: pre-wrap; line-height: 1.6;">{{content}}</div>
                        </div>
                        <hr class="my-4">
                    {{/comments}}

                    {{^comments}}
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-chat-dots" style="font-size: 3rem; opacity: 0.3;"></i>
                            <p class="mt-3 mb-0">아직 답변이 없습니다.</p>
                            <small>관리자가 곧 답변을 드릴 예정입니다.</small>
                        </div>
                    {{/comments}}
                </div>
            </div>

            <!-- 댓글 작성 카드 -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil-square"></i> 댓글 작성</h5>
                </div>
                <div class="card-body">
                    <form action="/inquiry/{{inquiry.id}}/comment" method="post">
                        <div class="mb-3">
                            <textarea class="form-control" name="content" rows="5"
                                      placeholder="댓글을 입력하세요..."
                                      required
                                      style="resize: none;"></textarea>
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> 추가 문의사항이나 보충 설명을 작성해주세요.
                            </small>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> 댓글 등록
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .inquiry-content {
        font-size: 1.05rem;
    }
    .card {
        border-radius: 10px;
    }
</style>

{{>layouts/shop-footer}}