{{>layouts/shop-header}}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">

            {{#message}}
                <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
                    {{message}}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {{/message}}

            <div class="d-flex justify-content-between mb-4">
                <h2>내 문의 내역</h2>
                <a href="/inquiry/new" class="btn btn-primary">문의하기</a>
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                        <tr>
                            <th width="80">번호</th>
                            <th width="120">유형</th>
                            <th>제목</th>
                            <th width="100">상태</th>
                            <th width="100">댓글</th>
                            <th width="150">작성일</th>
                        </tr>
                        </thead>

                        <tbody>
                        {{#inquiries.content}}
                            <tr onclick="location.href='/inquiry/{{id}}'" style="cursor:pointer;">
                                <td>{{id}}</td>
                                <td>{{typeDescription}}</td>
                                <td>{{title}}</td>
                                <td>{{statusDescription}}</td>
                                <td>{{commentCount}}</td>
                                <td>{{formattedCreatedAt}}</td>
                            </tr>
                        {{/inquiries.content}}

                        {{^inquiries.content}}
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    등록된 문의가 없습니다.
                                </td>
                            </tr>
                        {{/inquiries.content}}
                        </tbody>

                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

{{>layouts/shop-footer}}
