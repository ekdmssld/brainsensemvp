{{>layouts/shop-header}}

<div class="row justify-content-center">
    <div class="col-md-8">
        <!-- 주문 완료 메시지 -->
        <div class="card border-success mb-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size: 5rem;"></i>
                <h2 class="mt-3">주문이 완료되었습니다!</h2>
                <p class="text-muted">주문번호: <strong>{{order.id}}</strong></p>
            </div>
        </div>

        <!-- 주문 정보 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">주문 정보</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-4 text-muted">주문번호</div>
                    <div class="col-8"><strong>{{order.id}}</strong></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">주문일시</div>
                    <div class="col-8">{{order.formattedOrderDate}}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">주문상태</div>
                    <div class="col-8">
                        <span class="badge bg-info">{{order.statusDisplay}}</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-4 text-muted">결제금액</div>
                    <div class="col-8">
                        <strong class="text-primary fs-5">{{order.formattedPrice}}</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- 배송 정보 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">배송 정보</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-4 text-muted">받는 사람</div>
                    <div class="col-8">{{order.recipientName}}</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">연락처</div>
                    <div class="col-8">{{order.recipientPhone}}</div>
                </div>
                <div class="row">
                    <div class="col-4 text-muted">배송 주소</div>
                    <div class="col-8">{{order.deliveryAddress}}</div>
                </div>
            </div>
        </div>

        <!-- 주문 상품 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">주문 상품</h5>
            </div>
            <div class="card-body">
                {{#order.orderItems}}
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        {{#productImageUrl}}
                            <img src="{{productImageUrl}}" alt="{{productName}}"
                                 class="me-3 rounded" style="width: 80px; height: 80px; object-fit: cover;">
                        {{/productImageUrl}}
                        <div class="flex-grow-1">
                            <h6 class="mb-1">{{productName}}</h6>
                            <p class="text-muted mb-0">
                                <small>{{price}}원 x {{quantity}}개</small>
                            </p>
                        </div>
                        <div class="text-end">
                            <h6 class="text-primary mb-0">{{totalPrice}}원</h6>
                        </div>
                    </div>
                {{/order.orderItems}}
            </div>
        </div>

        <!-- 버튼 -->
        <div class="d-grid gap-2 mb-4">
            <a href="/mypage" class="btn btn-primary btn-lg">
                <i class="bi bi-person"></i> 마이페이지로 이동
            </a>
            <a href="/products" class="btn btn-outline-secondary">
                <i class="bi bi-shop"></i> 쇼핑 계속하기
            </a>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}