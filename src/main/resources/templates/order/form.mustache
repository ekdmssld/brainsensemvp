{{>layouts/shop-header}}

<div class="row">
    <div class="col-md-8">
        <h2><i class="bi bi-clipboard-check"></i> 주문서 작성</h2>
        <hr>

        <form action="/order/create" method="post">
            <!-- 주문 상품 목록 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">주문 상품 ({{cartItems.size}}개)</h5>
                </div>
                <div class="card-body">
                    {{#cartItems}}
                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                            {{#productImageUrl}}
                                <img src="{{productImageUrl}}" alt="{{productName}}"
                                     class="me-3 rounded" style="width: 80px; height: 80px; object-fit: cover;">
                            {{/productImageUrl}}
                            {{^productImageUrl}}
                                <div class="me-3 bg-light rounded d-flex align-items-center justify-content-center"
                                     style="width: 80px; height: 80px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                            {{/productImageUrl}}
                            <div class="flex-grow-1">
                                <h6 class="mb-1">{{productName}}</h6>
                                <p class="text-muted mb-0">
                                    <small>{{formattedPrice}} x {{quantity}}개</small>
                                </p>
                            </div>
                            <div class="text-end">
                                <h6 class="text-primary mb-0">{{formattedTotalPrice}}</h6>
                            </div>
                        </div>
                    {{/cartItems}}
                </div>
            </div>

            <!-- 배송 정보 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">배송 정보</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="recipientName" class="form-label">
                            <i class="bi bi-person"></i> 받는 사람 <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="recipientName"
                               name="recipientName" required placeholder="이름을 입력하세요">
                    </div>

                    <div class="mb-3">
                        <label for="recipientPhone" class="form-label">
                            <i class="bi bi-telephone"></i> 연락처 <span class="text-danger">*</span>
                        </label>
                        <input type="tel" class="form-control" id="recipientPhone"
                               name="recipientPhone" required
                               placeholder="010-1234-5678" pattern="[0-9]{2,3}-[0-9]{3,4}-[0-9]{4}">
                    </div>

                    <div class="mb-3">
                        <label for="deliveryAddress" class="form-label">
                            <i class="bi bi-geo-alt"></i> 배송 주소 <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="deliveryAddress"
                               name="deliveryAddress" required
                               placeholder="서울시 강남구 테헤란로 123">
                        <small class="form-text text-muted">
                            상세 주소까지 입력해주세요.
                        </small>
                    </div>

                    <div class="mb-0">
                        <label for="deliveryRequest" class="form-label">
                            <i class="bi bi-chat-left-text"></i> 배송 요청사항
                        </label>
                        <textarea class="form-control" id="deliveryRequest"
                                  name="deliveryRequest" rows="2"
                                  placeholder="배송 시 요청사항을 입력하세요 (선택)"></textarea>
                    </div>
                </div>
            </div>

            <!-- 결제 수단 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">결제 수단</h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethod"
                               id="card" value="CARD" checked>
                        <label class="form-check-label" for="card">
                            <i class="bi bi-credit-card"></i> 신용/체크카드
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethod"
                               id="transfer" value="TRANSFER">
                        <label class="form-check-label" for="transfer">
                            <i class="bi bi-bank"></i> 계좌이체
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="paymentMethod"
                               id="vbank" value="VBANK">
                        <label class="form-check-label" for="vbank">
                            <i class="bi bi-building"></i> 무통장입금
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentMethod"
                               id="phone" value="PHONE">
                        <label class="form-check-label" for="phone">
                            <i class="bi bi-phone"></i> 휴대폰 결제
                        </label>
                    </div>
                </div>
            </div>

            <!-- 약관 동의 -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="agreeAll" required>
                        <label class="form-check-label" for="agreeAll">
                            <strong>주문 내용을 확인하였으며, 결제에 동의합니다.</strong>
                            <span class="text-danger">*</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 주문 버튼 -->
            <div class="d-grid gap-2 mb-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-credit-card"></i> 결제하기
                </button>
                <a href="/cart" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> 장바구니로 돌아가기
                </a>
            </div>
        </form>
    </div>

    <!-- 결제 금액 -->
    <div class="col-md-4">
        <div class="card position-sticky" style="top: 100px;">
            <div class="card-header">
                <h5 class="mb-0">결제 금액</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>상품 금액</span>
                    <span>{{formattedTotalPrice}}</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>배송비</span>
                    <span>{{formattedDeliveryFee}}</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-3">
                    <strong>최종 결제 금액</strong>
                    <strong class="text-primary fs-4">{{formattedFinalPrice}}</strong>
                </div>

                <div class="alert alert-info mb-0">
                    <small>
                        <i class="bi bi-info-circle"></i>
                        30,000원 이상 구매 시 배송비 무료
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}