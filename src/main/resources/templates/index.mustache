{{>layouts/shop-header}}

<div class="container mt-4">
    <!-- 메인 배너 -->
    <div class="card bg-primary text-white mb-4">
        <div class="card-body text-center py-5">
            <h1><i class="bi bi-cpu"></i> Arduino Shop</h1>
            <p class="lead">아두이노 부품 및 키트 전문 쇼핑몰</p>
        </div>
    </div>

    <!-- 상품 목록 -->
    <h3 class="mb-4"><i class="bi bi-star"></i> 최신 상품</h3>
    <div class="row row-cols-1 row-cols-md-4 g-4 mb-4">
        {{#products}}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a href="/products/{{id}}" class="text-decoration-none">
                        {{#imageUrl}}
                            <img src="{{imageUrl}}" class="card-img-top" alt="{{name}}"
                                 style="height: 200px; object-fit: cover;">
                        {{/imageUrl}}
                        {{^imageUrl}}
                            <div style="height: 200px; background-color: #e9ecef;"
                                 class="d-flex align-items-center justify-content-center">
                                <i class="bi bi-image" style="font-size: 3rem; color: #adb5bd;"></i>
                            </div>
                        {{/imageUrl}}
                    </a>
                    <div class="card-body">
                        <h6 class="card-title">
                            <a href="/products/{{id}}" class="text-dark text-decoration-none">{{name}}</a>
                        </h6>
                        <p class="card-text text-muted small" style="height: 40px; overflow: hidden;">
                            {{description}}
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 text-primary mb-0">{{formattedPrice}}</span>
                            {{#hasStock}}
                                <span class="badge bg-success">재고 있음</span>
                            {{/hasStock}}
                        </div>
                    </div>
                </div>
            </div>
        {{/products}}
    </div>

    <!-- 더보기 -->
    <div class="text-center">
        <a href="/products" class="btn btn-primary btn-lg">
            <i class="bi bi-grid"></i> 전체 상품 보기
        </a>
    </div>
</div>

{{>layouts/shop-footer}}