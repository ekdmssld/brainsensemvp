{{>layouts/shop-header}}

<div class="container mt-4">
    <!-- 뒤로가기 -->
    <div class="mb-3">
        <a href="/products" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> 목록으로
        </a>
    </div>

    <!-- 성공 메시지 -->
    {{#successMessage}}
        <div class="alert alert-success alert-dismissible fade show">
            {{successMessage}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/successMessage}}

    <div class="row">
        <!-- 상품 이미지 -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body p-0">
                    {{#product.imageUrl}}
                        <img src="{{product.imageUrl}}" alt="{{product.name}}"
                             class="img-fluid w-100" style="max-height: 500px; object-fit: contain;">
                    {{/product.imageUrl}}
                    {{^product.imageUrl}}
                        <div style="height: 500px; background-color: #e9ecef;"
                             class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-image" style="font-size: 6rem; color: #adb5bd;"></i>
                        </div>
                    {{/product.imageUrl}}
                </div>
            </div>
        </div>

        <!-- 상품 정보 -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <!-- 카테고리 -->
                    <p class="text-muted mb-2">
                        <i class="bi bi-tag"></i> {{product.categoryName}}
                    </p>

                    <!-- 상품명 -->
                    <h2 class="mb-3">{{product.name}}</h2>

                    <!-- 제조사/모델 -->
                    {{#product.manufacturer}}
                        <p class="text-muted">
                            <strong>제조사:</strong> {{product.manufacturer}}
                            {{#product.modelNumber}} / <strong>모델:</strong> {{product.modelNumber}}{{/product.modelNumber}}
                        </p>
                    {{/product.manufacturer}}

                    <!-- 가격 -->
                    <div class="mb-4">
                        <h3 class="text-primary fw-bold">{{product.formattedPrice}}</h3>
                    </div>

                    <!-- 재고 상태 -->
                    <div class="mb-4">
                        {{#product.hasStock}}
                            <span class="badge bg-success fs-6">
                            <i class="bi bi-check-circle"></i> 재고 있음 ({{product.stock}}개)
                        </span>
                        {{/product.hasStock}}
                        {{^product.hasStock}}
                            <span class="badge bg-danger fs-6">
                            <i class="bi bi-x-circle"></i> 품절
                        </span>
                        {{/product.hasStock}}
                    </div>

                    <!-- 수량 선택 및 장바구니 -->
                    {{#product.hasStock}}

                        {{#user}}
                            <!-- ✅ 로그인 된 경우: 실제 장바구니 form 전송 -->
                            <form action="/cart/add" method="post" id="cartForm">
                                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>
                                <input type="hidden" name="productId" value="{{product.id}}">

                                <div class="mb-4">
                                    <label for="quantity" class="form-label fw-bold">수량</label>
                                    <div class="input-group" style="max-width: 200px;">
                                        <button type="button" class="btn btn-outline-secondary" onclick="decreaseQuantity()">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number" class="form-control text-center" id="quantity" name="quantity"
                                               value="1" min="1" max="{{product.stock}}" required>
                                        <button type="button" class="btn btn-outline-secondary" onclick="increaseQuantity()">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="d-grid gap-2 mb-3">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-cart-plus"></i> 장바구니 담기
                                    </button>
                                </div>
                            </form>
                        {{/user}}

                        {{^user}}
                            <!-- ❌ 로그인 안 된 경우: 클릭 시 로그인 페이지로 이동 -->
                            <div class="mb-4">
                                <label class="form-label fw-bold">수량</label>
                                <div class="input-group" style="max-width: 200px;">
                                    <!-- 그냥 보여만 주고 동작은 없음 (원하면 disabled 처리도 가능) -->
                                    <input type="number" class="form-control text-center"
                                           value="1" min="1" max="{{product.stock}}" disabled>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mb-3">
                                <a href="/login" class="btn btn-primary btn-lg">
                                <i class="bi bi-cart-plus"></i> 로그인 후 이용 가능
                                </a>
                            </div>
                        {{/user}}

                    {{/product.hasStock}}


                    <!-- 위시리스트 버튼 -->
                    <div class="d-grid gap-2">
                        {{#user}}
                            {{#isInWishlist}}
                                <form action="/wishlist/remove/{{product.id}}" method="post">
                                    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>  <!-- ✅ 추가 -->
                                    <input type="hidden" name="redirect" value="detail">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-heart-fill"></i> 위시리스트에서 제거
                                    </button>
                                </form>
                            {{/isInWishlist}}
                            {{^isInWishlist}}
                                <form action="/wishlist/add/{{product.id}}" method="post">
                                    <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"/>  <!-- ✅ 추가 -->
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i class="bi bi-heart"></i> 위시리스트에 추가
                                    </button>
                                </form>
                            {{/isInWishlist}}
                        {{/user}}
                        {{^user}}
                            <a href="/login" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-lock"></i> 로그인 후 이용 가능
                            </a>
                        {{/user}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 상품 설명 -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h4 class="mb-0"><i class="bi bi-file-text"></i> 상품 설명</h4>
                </div>
                <div class="card-body">
                    <p style="white-space: pre-wrap; line-height: 1.8;">{{product.description}}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const maxStock = {{product.stock}};

    function increaseQuantity() {
        const input = document.getElementById('quantity');
        const currentValue = parseInt(input.value);
        if (currentValue < maxStock) {
            input.value = currentValue + 1;
        }
    }

    function decreaseQuantity() {
        const input = document.getElementById('quantity');
        const currentValue = parseInt(input.value);
        if (currentValue > 1) {
            input.value = currentValue - 1;
        }
    }
</script>

{{>layouts/shop-footer}}