{{>layouts/shop-header}}

<div class="row">
    <div class="col-md-6">
        <!-- 상품 이미지 -->
        <div class="card">
            {{#product.imageUrl}}
                <img src="{{product.imageUrl}}" class="card-img-top" alt="{{product.name}}" style="max-height: 500px; object-fit: contain;">
            {{/product.imageUrl}}
            {{^product.imageUrl}}
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 500px;">
                    <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                </div>
            {{/product.imageUrl}}
        </div>
    </div>

    <div class="col-md-6">
        <!-- 상품 정보 -->
        <h2>{{product.name}}</h2>
        <hr>

        <div class="mb-4">
            <span class="badge bg-primary">{{product.categoryName}}</span>
            {{#product.manufacturer}}
                <span class="badge bg-secondary">{{product.manufacturer}}</span>
            {{/product.manufacturer}}
        </div>

        <div class="mb-4">
            <h3 class="text-primary">{{product.formattedPrice}}</h3>
            <p class="text-muted">
                <i class="bi bi-box-seam"></i> 재고: <strong>{{product.stockStatus}}</strong>
                {{#product.stock}}
                    ({{product.stock}}개)
                {{/product.stock}}
            </p>
        </div>

        <!-- 상품 설명 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> 상품 설명</h5>
            </div>
            <div class="card-body">
                <p>{{product.description}}</p>

                {{#product.manufacturer}}
                    <p class="mb-1"><strong>제조사:</strong> {{product.manufacturer}}</p>
                {{/product.manufacturer}}

                {{#product.modelNumber}}
                    <p class="mb-0"><strong>모델번호:</strong> {{product.modelNumber}}</p>
                {{/product.modelNumber}}
            </div>
        </div>

        <!-- 구매 옵션 -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label for="quantity" class="form-label">수량</label>
                    <div class="input-group" style="max-width: 150px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decreaseQuantity()">-</button>
                        <input type="number" class="form-control text-center" id="quantity" value="1" min="1" max="{{product.stock}}">
                        <button class="btn btn-outline-secondary" type="button" onclick="increaseQuantity()">+</button>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-lg" onclick="requireLogin(event); addToCart({{product.id}});">
                        <i class="bi bi-cart-plus"></i> 장바구니 담기
                    </button>
                    <button class="btn btn-outline-danger" onclick="requireLogin(event); addToWishlist({{product.id}});">
                        <i class="bi bi-heart"></i> 위시리스트
                    </button>
                    <a href="/products" class="btn btn-outline-secondary">
                        <i class="bi bi-list"></i> 목록으로
                    </a>
                </div>
            </div>
        </div>

        <!-- 안내 사항 -->
        <div class="alert alert-info">
            <h6><i class="bi bi-truck"></i> 배송 안내</h6>
            <ul class="mb-0 small">
                <li>평일 오후 2시 이전 주문 시 당일 발송</li>
                <li>배송비 3,000원 (30,000원 이상 무료배송)</li>
                <li>제주/도서산간 지역 추가 배송비 발생</li>
            </ul>
        </div>
    </div>
</div>

<!-- 상세 정보 탭 -->
<div class="row mt-5">
    <div class="col-12">
        <ul class="nav nav-tabs" id="productTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="detail-tab" data-bs-toggle="tab" data-bs-target="#detail" type="button">
                    상세정보
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button">
                    리뷰
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="qna-tab" data-bs-toggle="tab" data-bs-target="#qna" type="button">
                    Q&A
                </button>
            </li>
        </ul>
        <div class="tab-content border border-top-0 p-4" id="productTabContent">
            <div class="tab-pane fade show active" id="detail" role="tabpanel">
                <h5>상세 정보</h5>
                <p>{{product.description}}</p>
            </div>
            <div class="tab-pane fade" id="review" role="tabpanel">
                <h5>상품 리뷰</h5>
                <p class="text-muted">등록된 리뷰가 없습니다.</p>
            </div>
            <div class="tab-pane fade" id="qna" role="tabpanel">
                <h5>상품 문의</h5>
                <p class="text-muted">등록된 문의가 없습니다.</p>
            </div>
        </div>
    </div>
</div>

<script>
    function increaseQuantity() {
        const input = document.getElementById('quantity');
        const max = parseInt(input.max);
        const current = parseInt(input.value);
        if (current < max) {
            input.value = current + 1;
        }
    }

    function decreaseQuantity() {
        const input = document.getElementById('quantity');
        const current = parseInt(input.value);
        if (current > 1) {
            input.value = current - 1;
        }
    }

    function addToCart(productId) {
        const quantity = document.getElementById('quantity').value;
        alert(`상품을 장바구니에 담았습니다. (수량: ${quantity})`);
    }

    function addToWishlist(productId) {
        alert('위시리스트에 추가되었습니다.');
    }
</script>

{{>layouts/shop-footer}}