{{>layouts/shop-header}}

<div class="container mt-4">
    <!-- 메시지 표시 영역 -->
    {{#message}}
        <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
            {{message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/message}}

    <!-- 상품 상세 내용 -->
    <div class="row">
        <!-- 왼쪽: 상품 이미지 -->
        <div class="col-md-6">
            {{#product.imageUrl}}
                <img src="{{product.imageUrl}}" class="img-fluid rounded" alt="{{product.name}}" style="max-height: 500px; object-fit: contain;">
            {{/product.imageUrl}}
            {{^product.imageUrl}}
                <div style="height: 400px; background-color: #e9ecef;"
                     class="d-flex align-items-center justify-content-center rounded">
                    <i class="bi bi-image" style="font-size: 5rem; color: #adb5bd;"></i>
                </div>
            {{/product.imageUrl}}
        </div>

        <!-- 오른쪽: 상품 정보 -->
        <div class="col-md-6">
            <h2>{{product.name}}</h2>
            <hr>
            <div class="mb-3">
                <span class="text-warning fs-5">
                    {{#reviewCount}}
                        ★ {{averageRating}}
                    {{/reviewCount}}
                    {{^reviewCount}}
                        ☆☆☆☆☆
                    {{/reviewCount}}
                </span>
                <span class="text-muted ms-2">({{reviewCount}}개 리뷰)</span>
            </div>
            <h3 class="text-primary fw-bold">{{product.formattedPrice}}</h3>
            <p class="text-muted mt-3">{{product.description}}</p>

            <!-- 상품 상세 정보 -->
            <div class="card mb-3">
                <div class="card-body">
                    <p class="mb-2"><strong>카테고리:</strong> {{product.categoryName}}</p>
                    {{#product.manufacturer}}
                        <p class="mb-2"><strong>제조사:</strong> {{product.manufacturer}}</p>
                    {{/product.manufacturer}}
                    {{#product.modelNumber}}
                        <p class="mb-2"><strong>모델번호:</strong> {{product.modelNumber}}</p>
                    {{/product.modelNumber}}
                    <p class="mb-0">
                        <strong>재고:</strong>
                        {{#product.isAvailable}}
                            <span class="badge bg-success">{{product.stock}}개 재고있음</span>
                        {{/product.isAvailable}}
                        {{^product.isAvailable}}
                            <span class="badge bg-danger">품절</span>
                        {{/product.isAvailable}}
                    </p>
                </div>
            </div>

            {{#user}}
                <!-- 수량 선택 -->
                <div class="card mb-3">
                    <div class="card-body">
                        <label class="form-label fw-bold">수량</label>
                        <div class="input-group" style="max-width: 200px;">
                            <button class="btn btn-outline-secondary" type="button" id="decreaseBtn">
                                <i class="bi bi-dash"></i>
                            </button>
                            <input type="number" class="form-control text-center" id="quantity" value="1" min="1" max="{{product.stock}}" readonly>
                            <button class="btn btn-outline-secondary" type="button" id="increaseBtn">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 버튼 -->
                <div class="d-grid gap-2">
                    <!-- 장바구니 추가 -->
                    <form action="/cart/add" method="post" id="cartForm">
                        <input type="hidden" name="productId" value="{{product.id}}">
                        <input type="hidden" name="quantity" id="cartQuantity" value="1">
                        <button type="submit" class="btn btn-primary btn-lg w-100" {{^product.isAvailable}}disabled{{/product.isAvailable}}>
                            <i class="bi bi-cart-plus"></i> 장바구니 담기
                        </button>
                    </form>

                    <!-- 위시리스트 추가/제거 -->
                    {{#isInWishlist}}
                        <form action="/wishlist/remove/{{product.id}}" method="post">
                            <input type="hidden" name="redirect" value="detail">
                            <button type="submit" class="btn btn-outline-danger btn-lg w-100">
                                <i class="bi bi-heart-fill"></i> 위시리스트 제거
                            </button>
                        </form>
                    {{/isInWishlist}}
                    {{^isInWishlist}}
                        <form action="/wishlist/add/{{product.id}}" method="post">
                            <button type="submit" class="btn btn-outline-danger btn-lg w-100">
                                <i class="bi bi-heart"></i> 위시리스트 추가
                            </button>
                        </form>
                    {{/isInWishlist}}

                    <a href="/products" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> 목록으로
                    </a>
                </div>
            {{/user}}

            {{^user}}
                <div class="d-grid gap-2">
                    <a href="/login" class="btn btn-secondary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> 로그인이 필요합니다
                    </a>
                    <a href="/products" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> 목록으로
                    </a>
                </div>
            {{/user}}
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-12">
            <h3><i class="bi bi-chat-left-text"></i> 상품 리뷰 ({{reviewCount}})</h3>
            <hr>

            <!-- ✅ 리뷰 작성 폼 (배송 완료된 주문이 있을 때만 표시) -->
            {{#canWriteReview}}
                <div class="card mb-4 bg-light">
                    <div class="card-body">
                        <h5><i class="bi bi-pencil-square"></i> 리뷰 작성</h5>
                        <form action="/review/create" method="post">
                            <input type="hidden" name="productId" value="{{product.id}}">

                            <!-- 평점 선택 -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">평점 <span class="text-danger">*</span></label>
                                <div class="rating-input">
                                    <input type="radio" name="rating" value="5" id="star5" required>
                                    <label for="star5" title="5점">★</label>
                                    <input type="radio" name="rating" value="4" id="star4">
                                    <label for="star4" title="4점">★</label>
                                    <input type="radio" name="rating" value="3" id="star3">
                                    <label for="star3" title="3점">★</label>
                                    <input type="radio" name="rating" value="2" id="star2">
                                    <label for="star2" title="2점">★</label>
                                    <input type="radio" name="rating" value="1" id="star1">
                                    <label for="star1" title="1점">★</label>
                                </div>
                            </div>

                            <!-- 리뷰 내용 -->
                            <div class="mb-3">
                                <label for="reviewContent" class="form-label fw-bold">리뷰 내용 <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="reviewContent" name="content" rows="4"
                                          placeholder="상품 사용 후기를 작성해주세요." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> 리뷰 등록
                            </button>
                        </form>
                    </div>
                </div>
            {{/canWriteReview}}

            <!-- ✅ 리뷰 목록 -->
            {{#reviews}}
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong>{{memberName}}</strong>
                                <span class="text-warning ms-2">{{starRating}}</span>
                            </div>
                            <div>
                                <small class="text-muted">{{formattedCreatedAt}}</small>
                                {{#editable}}
                                    <button class="btn btn-sm btn-outline-danger ms-2"
                                            onclick="deleteReview({{id}}, {{productId}})">
                                        <i class="bi bi-trash"></i> 삭제
                                    </button>
                                {{/editable}}
                            </div>
                        </div>
                        <p class="mb-3" style="white-space: pre-wrap;">{{content}}</p>

                        <!-- 리뷰 댓글 -->
                        {{#comments}}
                            <div class="border-start border-primary border-3 ps-3 mb-2 bg-light p-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <small><strong>{{memberName}}</strong></small>
                                        <p class="mb-0 mt-1"><small>{{content}}</small></p>
                                    </div>
                                    <div>
                                        <small class="text-muted">{{formattedCreatedAt}}</small>
                                        {{#deletable}}
                                            <button class="btn btn-sm btn-outline-danger ms-1"
                                                    onclick="deleteComment({{id}}, {{productId}})">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        {{/deletable}}
                                    </div>
                                </div>
                            </div>
                        {{/comments}}

                        <!-- 댓글 작성 -->
                        {{#user}}
                            <form action="/review/{{id}}/comment" method="post" class="mt-3">
                                <input type="hidden" name="productId" value="{{productId}}">
                                <div class="input-group">
                                    <input type="text" class="form-control" name="content"
                                           placeholder="댓글을 입력하세요" required>
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="bi bi-send"></i> 댓글
                                    </button>
                                </div>
                            </form>
                        {{/user}}
                    </div>
                </div>
            {{/reviews}}

            {{^reviews}}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-left-text" style="font-size: 3rem;"></i>
                    <p class="mt-3">아직 작성된 리뷰가 없습니다.</p>
                </div>
            {{/reviews}}
        </div>
    </div>
</div>

<style>
    /* ✅ 별점 입력 스타일 */
    .rating-input {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        font-size: 2rem;
    }

    .rating-input input[type="radio"] {
        display: none;
    }

    .rating-input label {
        color: #ddd;
        cursor: pointer;
        transition: color 0.2s;
    }

    .rating-input label:hover,
    .rating-input label:hover ~ label,
    .rating-input input[type="radio"]:checked ~ label {
        color: #ffc107;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const quantityInput = document.getElementById('quantity');
        const cartQuantityInput = document.getElementById('cartQuantity');
        const decreaseBtn = document.getElementById('decreaseBtn');
        const increaseBtn = document.getElementById('increaseBtn');
        const maxStock = parseInt(quantityInput.max);

        // 수량 감소
        decreaseBtn.addEventListener('click', function() {
            let currentValue = parseInt(quantityInput.value);
            if (currentValue > 1) {
                quantityInput.value = currentValue - 1;
                cartQuantityInput.value = currentValue - 1;
            }
        });

        // 수량 증가
        increaseBtn.addEventListener('click', function() {
            let currentValue = parseInt(quantityInput.value);
            if (currentValue < maxStock) {
                quantityInput.value = currentValue + 1;
                cartQuantityInput.value = currentValue + 1;
            } else {
                alert('재고 수량을 초과할 수 없습니다.');
            }
        });

        // 직접 입력 방지 (readonly)
        quantityInput.addEventListener('input', function() {
            let value = parseInt(this.value);
            if (isNaN(value) || value < 1) {
                this.value = 1;
            } else if (value > maxStock) {
                this.value = maxStock;
                alert('재고 수량을 초과할 수 없습니다.');
            }
            cartQuantityInput.value = this.value;
        });
    });
    function deleteReview(reviewId, productId) {
        if (confirm('리뷰를 삭제하시겠습니까?')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/review/' + reviewId + '/delete';

            const productIdInput = document.createElement('input');
            productIdInput.type = 'hidden';
            productIdInput.name = 'productId';
            productIdInput.value = productId;

            form.appendChild(productIdInput);
            document.body.appendChild(form);
            form.submit();
        }
    }

    // ✅ 댓글 삭제
    function deleteComment(commentId, productId) {
        if (confirm('댓글을 삭제하시겠습니까?')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/review/comment/' + commentId + '/delete';

            const productIdInput = document.createElement('input');
            productIdInput.type = 'hidden';
            productIdInput.name = 'productId';
            productIdInput.value = productId;

            form.appendChild(productIdInput);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>

{{>layouts/shop-footer}}