{{>layouts/shop-header}}

<div class="container-fluid">
    <div class="row">
        <!-- 사이드바 - 카테고리 -->
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-grid"></i> 카테고리</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/products" class="list-group-item list-group-item-action">
                        전체상품
                    </a>
                    {{#categories}}
                        <a href="/products?category={{id}}" class="list-group-item list-group-item-action">
                        {{name}}
                        </a>
                        {{#children}}
                            <a href="/products?category={{id}}" class="list-group-item list-group-item-action ps-4">
                            └ {{name}}
                            </a>
                        {{/children}}
                    {{/categories}}
                </div>
            </div>
        </div>

        <!-- 메인 컨텐츠 -->
        <div class="col-md-9">
            <!-- 검색 결과 헤더 -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-box"></i> 전체 상품</h2>
                <div>
                    <span class="text-muted">총 {{products.totalElements}}개의 상품</span>
                </div>
            </div>

            <!-- 검색 바 -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" action="/products" class="row g-3">
                        <div class="col-md-10">
                            <input type="text" class="form-control" name="search"
                                   placeholder="상품명으로 검색하세요" value="{{search}}">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> 검색
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 상품 목록 -->
            <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
                {{#products.content}}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <a href="/products/{{id}}" class="text-decoration-none">
                                {{#imageUrl}}
                                    <img src="{{imageUrl}}" class="card-img-top" alt="{{name}}"
                                         style="height: 250px; object-fit: cover;">
                                {{/imageUrl}}
                                {{^imageUrl}}
                                    <div style="height: 250px; background-color: #e9ecef;"
                                         class="d-flex align-items-center justify-content-center">
                                        <i class="bi bi-image" style="font-size: 4rem; color: #adb5bd;"></i>
                                    </div>
                                {{/imageUrl}}
                            </a>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a href="/products/{{id}}" class="text-dark text-decoration-none">{{name}}</a>
                                </h5>
                                <p class="card-text text-muted small" style="height: 60px; overflow: hidden;">
                                    {{description}}
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="fs-5 text-primary fw-bold">{{formattedPrice}}</span>
                                    {{#hasStock}}
                                        <span class="badge bg-success">재고 있음</span>
                                    {{/hasStock}}
                                    {{^hasStock}}
                                        <span class="badge bg-danger">품절</span>
                                    {{/hasStock}}
                                </div>
                            </div>
                            <div class="card-footer bg-white border-top-0">
                                <a href="/products/{{id}}" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-eye"></i> 상세보기
                                </a>
                            </div>
                        </div>
                    </div>
                {{/products.content}}
            </div>

            <!-- 상품이 없을 때 -->
            {{^products.content}}
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 5rem; color: #ccc;"></i>
                    <p class="mt-3 text-muted fs-5">상품이 없습니다.</p>
                </div>
            {{/products.content}}

            <!-- 페이징 (한 번만 나오게, 반복문 밖으로 뺌) -->
            {{#products.totalPages}}
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <!-- 이전 -->
                        {{^products.first}}
                            <li class="page-item">
                                <a class="page-link" href="/products?page={{products.number}}">
                                <i class="bi bi-chevron-left"></i> 이전
                                </a>
                            </li>
                        {{/products.first}}
                        {{#products.first}}
                            <li class="page-item disabled">
                                <span class="page-link">
                                    <i class="bi bi-chevron-left"></i> 이전
                                </span>
                            </li>
                        {{/products.first}}

                        <!-- 현재 페이지 / 전체 페이지 -->
                        <li class="page-item active">
                            <span class="page-link">
                                {{products.number}} / {{products.totalPages}}
                            </span>
                        </li>

                        <!-- 다음 -->
                        {{^products.last}}
                            <li class="page-item">
                                <a class="page-link"
                                   href="/products?page={{products.nextPageable.pageNumber}}">
                                다음 <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        {{/products.last}}
                        {{#products.last}}
                            <li class="page-item disabled">
                                <span class="page-link">
                                    다음 <i class="bi bi-chevron-right"></i>
                                </span>
                            </li>
                        {{/products.last}}
                    </ul>
                </nav>
            {{/products.totalPages}}
        </div>
    </div>
</div>

{{>layouts/shop-footer}}