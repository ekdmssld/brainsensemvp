{{>layouts/shop-header}}

<div class="row">
    <!-- 사이드바 -->
    <div class="col-md-3">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-circle"></i> 마이페이지</h5>
            </div>
            <div class="list-group list-group-flush">
                <a href="/mypage" class="list-group-item list-group-item-action">
                    <i class="bi bi-house"></i> 대시보드
                </a>
                <a href="/mypage/orders" class="list-group-item list-group-item-action active">
                    <i class="bi bi-bag"></i> 주문 내역
                </a>
                <a href="/mypage/profile" class="list-group-item list-group-item-action">
                    <i class="bi bi-person"></i> 회원 정보 수정
                </a>
                <a href="/cart" class="list-group-item list-group-item-action">
                    <i class="bi bi-cart"></i> 장바구니
                </a>
                <a href="/logout" class="list-group-item list-group-item-action text-danger">
                    <i class="bi bi-box-arrow-right"></i> 로그아웃
                </a>
            </div>
        </div>
    </div>

    <!-- 주문 내역 -->
    <div class="col-md-9">
        <h2><i class="bi bi-bag"></i> 주문 내역</h2>
        <hr>

        {{#orders}}
            <div class="card mb-3">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>주문번호: {{id}}</strong>
                            <span class="ms-3 text-muted">{{formattedOrderDate}}</span>
                        </div>
                        <span class="badge bg-info">{{statusDisplay}}</span>
                    </div>
                </div>
                <div class="card-body">
                    {{#orderItems}}
                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                            {{#productImageUrl}}
                                <img src="{{productImageUrl}}" alt="{{productName}}"
                                     class="me-3 rounded" style="width: 80px; height: 80px; object-fit: cover;">
                            {{/productImageUrl}}
                            {{^productImageUrl}}
                                <div class="me-3 bg-light rounded d-flex align-items-center justify-content-center"
                                     style="width: 80px; height: 80px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                            {{/productImageUrl}}
                            <div class="flex-grow-1">
                                <h6 class="mb-1">
                                    <a href="/products/{{productId}}" class="text-dark text-decoration-none">
                                        {{productName}}
                                    </a>
                                </h6>
                                <p class="text-muted mb-0">
                                    <small>{{formattedPrice}} x {{quantity}}개</small>
                                </p>
                            </div>
                            <div class="text-end">
                                <h6 class="text-primary mb-0">{{formattedTotalPrice}}</h6>
                            </div>
                        </div>
                    {{/orderItems}}

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            <strong>총 결제 금액: </strong>
                            <span class="text-primary fs-5">{{formattedPrice}}</span>
                        </div>
                        <div>
                            <a href="/order/{{id}}" class="btn btn-outline-primary btn-sm me-2">
                                <i class="bi bi-eye"></i> 상세보기
                            </a>
                            {{#isCancellable}}
                                <form action="/order/cancel" method="post" style="display: inline;">
                                    <input type="hidden" name="orderId" value="{{id}}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('주문을 취소하시겠습니까?')">
                                        <i class="bi bi-x-circle"></i> 주문취소
                                    </button>
                                </form>
                            {{/isCancellable}}
                        </div>
                    </div>
                </div>
            </div>
        {{/orders}}

        {{^orders}}
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
                    <h4 class="mt-3">주문 내역이 없습니다</h4>
                    <p class="text-muted">지금 바로 쇼핑을 시작해보세요!</p>
                    <a href="/products" class="btn btn-primary mt-3">
                        <i class="bi bi-shop"></i> 쇼핑하러 가기
                    </a>
                </div>
            </div>
        {{/orders}}
    </div>
</div>

{{>layouts/shop-footer}}