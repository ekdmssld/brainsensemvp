{{>layouts/shop-header}}

<div class="container mt-4">
    <!--   메시지 표시 추가 -->
    {{#message}}
        <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
            {{message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/message}}

    <h2><i class="bi bi-heart-fill text-danger"></i> 위시리스트</h2>
    <hr>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        {{#products}}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a href="/products/{{id}}" class="text-decoration-none">
                        {{#imageUrl}}
                            <img src="{{imageUrl}}" class="card-img-top" alt="{{name}}"
                                 style="height: 200px; object-fit: cover;">
                        {{/imageUrl}}
                        {{^imageUrl}}
                            <div style="height: 200px; background-color: #e9ecef;"
                                 class="d-flex align-items-center justify-content-center">
                                <i class="bi bi-image" style="font-size: 3rem; color: #adb5bd;"></i>
                            </div>
                        {{/imageUrl}}
                    </a>
                    <div class="card-body">
                        <h6 class="card-title">
                            <a href="/products/{{id}}" class="text-decoration-none text-dark">{{name}}</a>
                        </h6>
                        <p class="text-primary fw-bold mb-0">{{formattedPrice}}</p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <form action="/wishlist/remove/{{id}}" method="post" class="d-inline w-100">
                            <!--   CSRF 토큰 수정 -->
                            <button type="submit" class="btn btn-danger btn-sm w-100">
                                <i class="bi bi-trash"></i> 제거
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {{/products}}
    </div>

    {{^products}}
        <div class="text-center py-5">
            <i class="bi bi-heart" style="font-size: 5rem; color: #ccc;"></i>
            <p class="mt-3 text-muted">위시리스트가 비어있습니다.</p>
            <a href="/products" class="btn btn-primary">
                <i class="bi bi-box-seam"></i> 상품 보러가기
            </a>
        </div>
    {{/products}}
</div>

{{>layouts/shop-footer}}