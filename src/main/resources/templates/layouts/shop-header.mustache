<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>아두이노 쇼핑몰 - Arduino Parts Store</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
        }
        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: #0d6efd !important;
        }
        .nav-link {
            font-weight: 500;
        }
        .top-nav {
            background-color: #f8f9fa;
            padding: 8px 0;
            font-size: 0.9rem;
        }
        .top-nav a {
            color: #6c757d;
            text-decoration: none;
            margin-left: 15px;
        }
        .top-nav a:hover {
            color: #0d6efd;
        }
        .dropdown-menu {
            border-radius: 8px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .search-box {
            min-width: 300px;
        }
    </style>
</head>
<body>
<!-- 상단 안내 바 -->
<div class="top-nav">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-end align-items-center">

            {{#isAdmin}}
                <li class="nav-item">
                    <a class="nav-link text-danger" href="/admin">
                        <i class="bi bi-speedometer2"></i> 관리자 대시보드
                    </a>
                </li>
            {{/isAdmin}}

            <a href="/inquiry"><i class="bi bi-headset"></i> 고객센터</a>

            {{#user}}
                <a href="/mypage"><i class="bi bi-person"></i> {{username}}님</a>
                <a href="/cart"><i class="bi bi-cart3"></i> 장바구니</a>
                <a href="/logout"><i class="bi bi-box-arrow-right"></i> 로그아웃</a>
            {{/user}}

            {{^user}}
                <a href="/login"><i class="bi bi-box-arrow-in-right"></i> 로그인</a>
                <a href="/signup"><i class="bi bi-person-plus"></i> 회원가입</a>
            {{/user}}
        </div>
    </div>
</div>


<!-- 메인 네비게이션 -->
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container-fluid px-4">
        <a class="navbar-brand" href="/">
            <i class="bi bi-cpu"></i> Arduino Shop
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <!-- 카테고리 메뉴 -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="/products">전체상품</a>
                </li>
                {{#categories}}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            {{name}}
                        </a>
                        <ul class="dropdown-menu">
                            <li> <a class="dropdown-item" href="/products?category={{id}}">{{name}} 전체</a> </li>
                            {{#children}}
                                <li><a class="dropdown-item" href="/products?category={{id}}">└ {{name}}</a></li>
                            {{/children}}
                        </ul>
                    </li>
                {{/categories}}
            </ul>

            <!-- 검색 바 -->
            <form class="d-flex search-box" action="/products" method="get">
                <input class="form-control me-2" type="search" name="search" placeholder="상품 검색...">
                <button class="btn btn-outline-primary" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>
</nav>

<!-- 알림 메시지 -->
{{#msg}}
    <div class="container-fluid px-4 mt-3">
        <div class="alert alert-primary alert-dismissible fade show" role="alert">
            {{msg}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
{{/msg}}

