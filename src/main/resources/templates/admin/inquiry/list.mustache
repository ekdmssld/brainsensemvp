{{>layouts/shop-header}}

<div class="container-fluid">
    <div class="row">
        <!-- 사이드바 -->
        <div class="col-md-2 bg-light vh-100">
            <div class="list-group mt-3">
                <a href="/admin" class="list-group-item list-group-item-action">
                    <i class="bi bi-speedometer2"></i> 대시보드
                </a>
                <a href="/admin/products" class="list-group-item list-group-item-action">
                    <i class="bi bi-box"></i> 상품 관리
                </a>
                <a href="/admin/orders" class="list-group-item list-group-item-action">
                    <i class="bi bi-receipt"></i> 주문 관리
                </a>
                <a href="/admin/users" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i> 회원 관리
                </a>
                <a href="/admin/inquiry" class="list-group-item list-group-item-action active">
                    <i class="bi bi-headset"></i> 고객센터
                </a>
            </div>
        </div>

        <!-- 메인 컨텐츠 -->
        <div class="col-md-10">
            <div class="mt-4">
                <!-- 메시지 표시 -->
                {{#message}}
                    <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
                        {{message}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {{/message}}

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2><i class="bi bi-headset"></i> 고객센터 관리</h2>
                        <p class="text-muted mb-0">답변 대기: <strong class="text-danger">{{pendingCount}}건</strong></p>
                    </div>
                </div>

                <!-- 검색 -->
                <div class="card mb-3">
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="keyword"
                                       value="{{keyword}}" placeholder="제목 또는 내용으로 검색">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search"></i> 검색
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- 문의 목록 -->
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th width="80">번호</th>
                                    <th width="100">작성자</th>
                                    <th width="120">문의유형</th>
                                    <th>제목</th>
                                    <th width="100">상태</th>
                                    <th width="80">댓글</th>
                                    <th width="150">작성일</th>
                                    <th width="100">관리</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#inquiries.content}}
                                    <tr>
                                        <td>{{id}}</td>
                                        <td>{{username}}</td>
                                        <td><span class="badge bg-info">{{typeDescription}}</span></td>
                                        <td class="text-start">
                                            <a href="/admin/inquiry/{{id}}" class="text-decoration-none">
                                                {{title}}
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-{{statusBadgeClass}}">{{statusDescription}}</span>
                                        </td>
                                        <td>
                                            {{#commentCount}}
                                                <span class="text-primary">
                                                <i class="bi bi-chat-dots"></i> {{commentCount}}
                                            </span>
                                            {{/commentCount}}
                                            {{^commentCount}}-{{/commentCount}}
                                        </td>
                                        <td class="text-muted small">{{formattedCreatedAt}}</td>
                                        <td>
                                            <a href="/admin/inquiry/{{id}}" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> 상세
                                            </a>
                                        </td>
                                    </tr>
                                {{/inquiries.content}}
                                {{^inquiries.content}}
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                                            <p class="mt-3">등록된 문의가 없습니다.</p>
                                        </td>
                                    </tr>
                                {{/inquiries.content}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 페이징 -->
                {{#inquiries.content}}
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            {{^inquiries.first}}
                                <li class="page-item">
                                    <a class="page-link" href="/admin/inquiry?page={{inquiries.number}}{{#keyword}}&keyword={{keyword}}{{/keyword}}">이전</a>
                                </li>
                            {{/inquiries.first}}

                            <li class="page-item active">
                                <span class="page-link">{{inquiries.number}} / {{inquiries.totalPages}}</span>
                            </li>

                            {{^inquiries.last}}
                                <li class="page-item">
                                    <a class="page-link" href="/admin/inquiry?page={{inquiries.number}}{{#keyword}}&keyword={{keyword}}{{/keyword}}">다음</a>
                                </li>
                            {{/inquiries.last}}
                        </ul>
                    </nav>
                {{/inquiries.content}}
            </div>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}