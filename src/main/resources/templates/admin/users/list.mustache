{{>layouts/shop-header}}

<div class="container-fluid">
    <div class="row">
        <!-- 사이드바 -->
        <div class="col-md-2 bg-light vh-100">
            <div class="list-group mt-3">
                <a href="/admin" class="list-group-item list-group-item-action">
                    <i class="bi bi-speedometer2"></i> 대시보드
                </a>
                <a href="/admin/products" class="list-group-item list-group-item-action">
                    <i class="bi bi-box"></i> 상품 관리
                </a>
                <a href="/admin/orders" class="list-group-item list-group-item-action">
                    <i class="bi bi-receipt"></i> 주문 관리
                </a>
                <a href="/admin/users" class="list-group-item list-group-item-action active">
                    <i class="bi bi-people"></i> 회원 관리
                </a>
                <a href="/admin/inquiry" class="list-group-item list-group-item-action">
                    <i class="bi bi-headset"></i> 문의 관리
                </a>
            </div>
        </div>

        <!-- 메인 컨텐츠 -->
        <div class="col-md-10">
            <div class="mt-4">
                <!-- 헤더 -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="bi bi-people"></i> 회원 관리</h2>
                </div>

                <!-- 검색 -->
                <div class="card mb-4">
                    <div class="card-body">
                        <form method="get" action="/admin/users" class="row g-3">
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="search"
                                       placeholder="회원 이름 또는 이메일로 검색" value="{{search}}">
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search"></i> 검색
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- 회원 목록 테이블 -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            전체 회원: {{users.totalElements}}명
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>아이디</th>
                                    <th>이메일</th>
                                    <th>전화번호</th>
                                    <th>주소</th>
                                    <th>권한</th>
                                    <th>가입일</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#users.content}}
                                    <tr>
                                        <td>{{id}}</td>
                                        <td>
                                            <strong>{{username}}</strong>
                                            {{#role}}
                                                {{#role.name}}
                                                    {{#equals}}ADMIN{{/equals}}
                                                    <span class="badge bg-danger">ADMIN</span>
                                                {{/role.name}}
                                            {{/role}}
                                        </td>
                                        <td>{{email}}</td>
                                        <td>{{phone}}</td>
                                        <td>
                                            {{#address}}
                                                <small class="text-muted">{{address}}</small>
                                            {{/address}}
                                            {{^address}}
                                                <small class="text-muted">미등록</small>
                                            {{/address}}
                                        </td>
                                        <td>
                                            {{#role}}
                                                {{#role.name}}
                                                    {{#equals}}ADMIN{{/equals}}
                                                    <span class="badge bg-danger">관리자</span>
                                                {{/role.name}}
                                                {{#role.name}}
                                                    {{#equals}}USER{{/equals}}
                                                    <span class="badge bg-primary">일반회원</span>
                                                {{/role.name}}
                                            {{/role}}
                                        </td>
                                        <td>
                                            <small>{{createdAt}}</small>
                                        </td>
                                    </tr>
                                {{/users.content}}
                                </tbody>
                            </table>
                        </div>

                        <!-- 회원이 없을 때 -->
                        {{^users.content}}
                            <div class="text-center py-5">
                                <i class="bi bi-person-x" style="font-size: 5rem; color: #ccc;"></i>
                                <p class="mt-3 text-muted">회원이 없습니다.</p>
                            </div>
                        {{/users.content}}
                    </div>
                </div>

                <!-- 페이징 -->
                {{#users.content}}
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <!-- 이전 -->
                            {{^users.first}}
                                <li class="page-item">
                                    <a class="page-link" href="/admin/users?page={{users.number}}&search={{search}}">
                                    <i class="bi bi-chevron-left"></i> 이전
                                    </a>
                                </li>
                            {{/users.first}}
                            {{#users.first}}
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="bi bi-chevron-left"></i> 이전</span>
                                </li>
                            {{/users.first}}

                            <!-- 페이지 번호 -->
                            <li class="page-item active">
                                <span class="page-link">{{users.number}} / {{users.totalPages}}</span>
                            </li>

                            <!-- 다음 -->
                            {{^users.last}}
                                <li class="page-item">
                                    <a class="page-link" href="/admin/users?page={{users.nextPageable.pageNumber}}&search={{search}}">
                                    다음 <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            {{/users.last}}
                            {{#users.last}}
                                <li class="page-item disabled">
                                    <span class="page-link">다음 <i class="bi bi-chevron-right"></i></span>
                                </li>
                            {{/users.last}}
                        </ul>
                    </nav>
                {{/users.content}}
            </div>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}