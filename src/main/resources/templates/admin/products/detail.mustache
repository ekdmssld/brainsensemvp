{{>layouts/shop-header}}

<div class="container mt-4">
    <!-- ✅ 메시지 표시 영역 추가 -->
    {{#message}}
        <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
            <i class="bi bi-{{#alertType}}{{#equals alertType 'success'}}check-circle-fill{{/equals}}{{#equals alertType 'warning'}}exclamation-triangle-fill{{/equals}}{{#equals alertType 'danger'}}x-circle-fill{{/equals}}{{/alertType}} me-2"></i>
            <strong>{{message}}</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/message}}

    <!-- 상품 상세 내용 -->
    <div class="row">
        <!-- 왼쪽: 상품 이미지 -->
        <div class="col-md-6">
            {{#product.imageUrl}}
                <img src="{{product.imageUrl}}" class="img-fluid rounded" alt="{{product.name}}">
            {{/product.imageUrl}}
            {{^product.imageUrl}}
                <div style="height: 400px; background-color: #e9ecef;"
                     class="d-flex align-items-center justify-content-center rounded">
                    <i class="bi bi-image" style="font-size: 5rem; color: #adb5bd;"></i>
                </div>
            {{/product.imageUrl}}
        </div>

        <!-- 오른쪽: 상품 정보 -->
        <div class="col-md-6">
            <h2>{{product.name}}</h2>
            <hr>
            <h3 class="text-primary">{{product.formattedPrice}}</h3>
            <p class="text-muted">{{product.description}}</p>

            <!-- 상품 상세 정보 -->
            <div class="card mb-3">
                <div class="card-body">
                    <p class="mb-2"><strong>카테고리:</strong> {{product.categoryName}}</p>
                    <p class="mb-2"><strong>제조사:</strong> {{product.manufacturer}}</p>
                    <p class="mb-2"><strong>모델번호:</strong> {{product.modelNumber}}</p>
                    <p class="mb-0">
                        <strong>재고:</strong>
                        {{#product.isAvailable}}
                            <span class="badge bg-success">{{product.}}개 재고있음</span>
                        {{/product.isAvailable}}
                        {{^product.isAvailable}}
                            <span class="badge bg-danger">품절</span>
                        {{/product.isAvailable}}
                    </p>
                </div>
            </div>

            <!-- 버튼 -->
            <div class="d-grid gap-2">
                {{#user}}
                    <!-- 장바구니 추가 -->
                    <form action="/cart/add" method="post">
                        <input type="hidden" name="productId" value="{{product.id}}">
                        <button type="submit" class="btn btn-primary btn-lg w-100" {{^product.isAvailable}}disabled{{/product.isAvailable}}>
                            <i class="bi bi-cart-plus"></i> 장바구니 담기
                        </button>
                    </form>

                    <!-- 위시리스트 추가/제거 -->
                    {{#isInWishlist}}
                        <form action="/wishlist/remove/{{product.id}}" method="post">
                            <input type="hidden" name="redirect" value="detail">
                            <button type="submit" class="btn btn-outline-danger btn-lg w-100">
                                <i class="bi bi-heart-fill"></i> 위시리스트 제거
                            </button>
                        </form>
                    {{/isInWishlist}}
                    {{^isInWishlist}}
                        <form action="/wishlist/add/{{product.id}}" method="post">
                            <button type="submit" class="btn btn-outline-danger btn-lg w-100">
                                <i class="bi bi-heart"></i> 위시리스트 추가
                            </button>
                        </form>
                    {{/isInWishlist}}
                {{/user}}

                {{^user}}
                    <a href="/login" class="btn btn-secondary btn-lg">로그인이 필요합니다</a>
                {{/user}}

                <a href="/products" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> 목록으로
                </a>
            </div>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}