{{>layouts/shop-header}}

<div class="container-fluid">
    <div class="row">
        <!-- 사이드바 -->
        <div class="col-md-2 bg-light vh-100">
            <div class="list-group mt-3">
                <a href="/admin" class="list-group-item list-group-item-action active">
                    <i class="bi bi-speedometer2"></i> 대시보드
                </a>
                <a href="/admin/products" class="list-group-item list-group-item-action">
                    <i class="bi bi-box"></i> 상품 관리
                </a>
                <a href="/admin/orders" class="list-group-item list-group-item-action">
                    <i class="bi bi-receipt"></i> 주문 관리
                </a>
                <a href="/admin/users" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i> 회원 관리
                </a>
                <a href="/" class="list-group-item list-group-item-action">
                    <i class="bi bi-house"></i> 메인으로
                </a>
            </div>
        </div>

        <!-- 메인 컨텐츠 -->
        <div class="col-md-10">
            <div class="mt-4">
                {{#message}}
                    <div class="alert
                {{#isSuccess}}alert-success{{/isSuccess}}
                        {{#isDanger}}alert-danger{{/isDanger}}
                alert-dismissible fade show" role="alert">

                        {{#isSuccess}}
                            <i class="bi bi-check-circle-fill"></i>
                        {{/isSuccess}}

                        {{#isDanger}}
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        {{/isDanger}}

                        {{message}}

                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {{/message}}

                <h2><i class="bi bi-speedometer2"></i> 관리자 대시보드</h2>
                <hr>

                <!-- 통계 카드 -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">총 상품</h6>
                                        <h2 class="mb-0">{{totalProducts}}</h2>
                                    </div>
                                    <i class="bi bi-box" style="font-size: 3rem; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">총 주문</h6>
                                        <h2 class="mb-0">{{totalOrders}}</h2>
                                    </div>
                                    <i class="bi bi-cart" style="font-size: 3rem; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">총 회원</h6>
                                        <h2 class="mb-0">{{totalUsers}}</h2>
                                    </div>
                                    <i class="bi bi-people" style="font-size: 3rem; opacity: 0.5;"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <h5 class="card-title">답변 대기</h5>
                                <h2 class="mb-0">{{pendingInquiryCount}}건</h2>
                                <a href="/admin/inquiry" class="text-white text-decoration-none">
                                    <small><i class="bi bi-arrow-right-circle"></i> 바로가기</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 최근 주문 -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> 최근 주문</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                <tr>
                                    <th>주문번호</th>
                                    <th>주문자</th>
                                    <th>상품수</th>
                                    <th>금액</th>
                                    <th>상태</th>
                                    <th>주문일시</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#recentOrders}}
                                    <tr>
                                        <td><a href="/admin/orders/{{id}}">#{{id}}</a></td>
                                        <td>{{memberName}}</td>
                                        <td>{{productCount}}개</td>
                                        <td>{{formattedPrice}}</td>
                                        <td><span class="badge bg-info">{{statusDisplay}}</span></td>
                                        <td>{{formattedOrderDate}}</td>
                                    </tr>
                                {{/recentOrders}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-headset"></i> 최근 문의</h5>
                            <a href="/admin/inquiry" class="btn btn-sm btn-outline-primary">
                                전체보기 <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                <tr>
                                    <th width="80">번호</th>
                                    <th width="100">작성자</th>
                                    <th width="120">유형</th>
                                    <th>제목</th>
                                    <th width="100">상태</th>
                                    <th width="150">작성일</th>
                                </tr>
                                </thead>
                                <tbody>
                                {{#recentInquiries}}
                                    <tr>
                                        <td>{{id}}</td>
                                        <td>{{username}}</td>
                                        <td><span class="badge bg-info">{{typeDescription}}</span></td>
                                        <td>
                                            <a href="/admin/inquiry/{{id}}" class="text-decoration-none">
                                                {{title}}
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-{{statusBadgeClass}}">{{statusDescription}}</span>
                                        </td>
                                        <td class="text-muted small">{{formattedCreatedAt}}</td>
                                    </tr>
                                {{/recentInquiries}}
                                {{^recentInquiries}}
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">문의 내역이 없습니다.</td>
                                    </tr>
                                {{/recentInquiries}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{>layouts/shop-footer}}