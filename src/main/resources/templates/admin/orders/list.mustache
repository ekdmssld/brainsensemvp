{{>layouts/shop-header}}

<div class="container mt-4">
    <h2>주문 관리</h2>
    <hr>

    <table class="table table-hover">
        <thead>
        <tr>
            <th>ID</th>
            <th>주문자</th>
            <th>총 금액</th>
            <th>상태</th>
            <th>주문 일시</th>
            <th>상세보기</th>
        </tr>
        </thead>
        <tbody>
        {{#orders}}
            <tr>
                <td>{{id}}</td>
                <td>{{memberName}}</td>
                <td>{{formattedPrice}}</td>
                <td>{{statusDisplay}}</td>
                <td>{{formattedOrderDate}}</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/admin/orders/{{id}}">
                        상세
                    </a>
                </td>
            </tr>
        {{/orders}}
        {{^orders}}
            <tr>
                <td colspan="6" class="text-center text-muted">주문이 없습니다.</td>
            </tr>
        {{/orders}}
        </tbody>
    </table>
</div>

{{>layouts/shop-footer}}
