{{>layouts/shop-header}}

<div class="container mt-4">
    {{#message}}
        <div class="alert alert-{{alertType}} alert-dismissible fade show" role="alert">
            {{message}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {{/message}}
    <h2><i class="bi bi-receipt"></i> 주문 상세 (#{{order.id}})</h2>
    <form action="/admin/orders/{{order.id}}/status" method="post" class="mt-3">

        <label class="form-label fw-bold">주문 상태 변경</label>
        <select name="status" class="form-select">

            <option value="PENDING"   {{#order.pending}}selected{{/order.pending}}>주문 대기</option>
            <option value="CONFIRMED" {{#order.confirmed}}selected{{/order.confirmed}}>주문 확인</option>
            <option value="PREPARING" {{#order.preparing}}selected{{/order.preparing}}>상품 준비중</option>
            <option value="SHIPPED"   {{#order.shipped}}selected{{/order.shipped}}>배송중</option>
            <option value="DELIVERED" {{#order.delivered}}selected{{/order.delivered}}>배송완료</option>
            <option value="CANCELLED" {{#order.cancelled}}selected{{/order.cancelled}}>취소됨</option>
            <option value="REFUNDED"  {{#order.refunded}}selected{{/order.refunded}}>환불됨</option>

        </select>

        <button type="submit" class="btn btn-primary mt-3">상태 저장</button>
    </form>
    <hr>

    <h5>주문 정보</h5>
    <p><strong>주문자:</strong> {{order.memberName}}</p>
    <p><strong>주문일:</strong> {{order.formattedOrderDate}}</p>
    <p><strong>상태:</strong> {{order.statusDisplay}}</p>

    <hr>

    <h5>배송 정보</h5>
    <p><strong>수령인:</strong> {{order.recipientName}}</p>
    <p><strong>연락처:</strong> {{order.recipientPhone}}</p>
    <p><strong>주소:</strong> {{order.deliveryAddress}}</p>

    <hr>

    <h5>주문 상품</h5>
    <table class="table">
        <thead>
        <tr>
            <th>상품</th>
            <th>단가</th>
            <th>수량</th>
            <th>총 금액</th>
        </tr>
        </thead>
        <tbody>
        {{#order.orderItems}}
            <tr>
                <td>{{productName}}</td>
                <td>{{formattedPrice}}</td>
                <td>{{quantity}}</td>
                <td>{{formattedTotalPrice}}</td>
            </tr>
        {{/order.orderItems}}
        </tbody>
    </table>

    <h4 class="text-end">총 결제 금액: <strong>{{order.formattedPrice}}</strong></h4>

    <a href="/admin/orders" class="btn btn-secondary mt-3">뒤로가기</a>
</div>

{{>layouts/shop-footer}}
