# 서버 설정
PORT=5000
NODE_ENV=development

# MongoDB 연결 (로컬)
MONGODB_URI=mongodb://localhost:27017/labit-mvp

# MongoDB Atlas (클라우드 - 선택사항)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/labit-mvp?retryWrites=true&w=majority

# JWT 설정
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# 클라이언트 URL (CORS)
CLIENT_URL=http://localhost:8080